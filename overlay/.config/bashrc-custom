# -----------------------------------------------------
# Functions
# -----------------------------------------------------
setmime() {
  local file mime desktop selected

  if [ $# -ne 1 ]; then
    echo "Uso: setmime <archivo>"
    return 1
  fi

  file="$1"

  if [ ! -e "$file" ]; then
    echo "Error: el archivo no existe: $file"
    return 1
  fi

  if ! command -v xdg-mime >/dev/null 2>&1; then
    echo "Error: xdg-mime no está instalado"
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "Error: fzf no está instalado"
    return 1
  fi

  mime="$(xdg-mime query filetype "$file")"
  if [ -z "$mime" ]; then
    echo "Error: no se pudo detectar el MIME del archivo"
    return 1
  fi

  selected="$(
    find /usr/share/applications -maxdepth 1 -type f -name '*.desktop' | sort | fzf \
      --prompt="Elige aplicación para $mime > " \
      --preview='basename {}'
  )"

  if [ -z "$selected" ]; then
    echo "Cancelado"
    return 1
  fi

  desktop="$(basename "$selected")"

  if ! xdg-mime default "$desktop" "$mime"; then
    echo "Error: no se pudo asignar $desktop para $mime"
    return 1
  fi

  echo "Asignado: $mime -> $desktop"
}

